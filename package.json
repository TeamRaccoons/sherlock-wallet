{
  "private": true,
  "version": "0.1.2",
  "name": "sherlock-extension",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20"
  },
  "author": "",
  "license": "Apache-2.0",
  "source": "src/manifest.json",
  "scripts": {
    "clean": "shx mkdir -p .parcel-cache dist lib build && shx rm -rf .parcel-cache dist lib build",
    "start": "shx rm -rf dist && parcel --host localhost --port 1234 --no-hmr",
    "build": "shx rm -rf build .parcel-cache && parcel build --dist-dir build --no-source-maps",
    "fmt": "prettier --write '{*,**/*}.{ts,tsx,js,jsx,json}'",
    "lint": "prettier --check '{*,**/*}.{ts,tsx,js,jsx,json}' && eslint .",
    "typecheck": "tsc --noEmit -p .",
    "inspect": "tsx scripts/inspect.ts"
  },
  "dependencies": {
    "@solana/kit": "8.5.0",
    "@solana/wallet-standard": "1.1.8",
    "@solana/wallet-standard-chains": "^1.1.2",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/core": "1.1.2",
    "bs58": "^4.0.1",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.90.0"
  },
  "devDependencies": {
    "@parcel/config-webextension": "^2.10.0",
    "@types/bs58": "^4.0.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "buffer": "^5.5.0",
    "events": "^3.1.0",
    "https-browserify": "^1.0.0",
    "parcel": "^2.10.0",
    "postcss": "^8.4.28",
    "prettier": "^3.0.2",
    "process": "^0.11.10",
    "punycode": "^1.4.1",
    "shx": "^0.3.4",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.1.0",
    "string_decoder": "^1.3.0",
    "tailwindcss": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "url": "^0.11.0",
    "util": "^0.12.3"
  },
  "@parcel/bundler-default": {
    "minBundleSize": 1000000000
  },
  "browserslist": [
    "Chrome >= 100"
  ]
}
