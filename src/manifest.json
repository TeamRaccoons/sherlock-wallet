{
  "manifest_version": 3,
  "name": "Sherlock Wallet",
  "description": "Impersonate any Solana address in dapps and inspect every transaction they ask you to sign: simulation, balance changes, Jupiter slippage, fees, decoded instructions.",
  "version": "0.1.2",
  "icons": {
    "16": "resources/icon16.png",
    "32": "resources/icon32.png",
    "48": "resources/icon48.png",
    "128": "resources/icon128.png"
  },
  "action": {
    "default_title": "Open Sherlock"
  },
  "side_panel": {
    "default_path": "ui/popup.html"
  },
  "background": {
    "service_worker": "background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content/index.ts"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "chromeos": "Alt+Shift+X",
        "linux": "Alt+Shift+X",
        "mac": "Alt+Shift+X",
        "windows": "Alt+Shift+X"
      }
    }
  },
  "permissions": ["storage", "sidePanel"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": ["https://api.jup.ag/*", "http://127.0.0.1/*", "http://localhost/*"]
}
